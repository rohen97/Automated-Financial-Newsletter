<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <meta name="x-apple-disable-message-reformatting">
    <title>{{ newsletter.title }} - Editorial V2</title>
    <style>
{{ css }}
    </style>
    <!--[if mso]>
    <style>
      body, table, td, div, p, a { font-family: Arial, Helvetica, sans-serif !important; }
      .container, .masthead, .intro-section, .chart-section, .delta-section, .markets-section,
      .portfolio-section, .outlook-section, .scan-section {
        background-color: #ffffff !important;
        color: #17202b !important;
      }
      .feature-section, .footer { background-color: #111820 !important; }
      .number { mso-number-format: "\@"; }
    </style>
    <![endif]-->
  </head>
  <body class="email-body" bgcolor="#e8e9e7" style="margin:0;padding:0;background-color:#e8e9e7;color:#17202b;">
    <div class="preheader">Wolf Research: three market signals, one feature, and the week ahead.</div>
    <table role="presentation" class="page" width="100%" bgcolor="#e8e9e7" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:#e8e9e7;table-layout:fixed;">
      <tr>
        <td align="center">
          <table role="presentation" class="container" width="700" bgcolor="#fcfbf8" cellpadding="0" cellspacing="0" border="0" style="width:700px;max-width:700px;background-color:#fcfbf8;table-layout:fixed;">
            <tr><td class="top-rule" bgcolor="#15355b" style="height:6px;line-height:6px;font-size:1px;background-color:#15355b;">&nbsp;</td></tr>
            <tr>
              <td class="masthead" bgcolor="#fcfbf8" style="padding:24px 32px 20px;background-color:#fcfbf8;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td class="logo-cell" width="48" style="width:48px;vertical-align:middle;">
                      <div class="brand-mark">WR</div>
                    </td>
                    <td class="brand-cell" style="vertical-align:middle;">
                      <div class="brand">Wolf Research</div>
                      <div class="edition">{{ newsletter.title }} / {{ display_header_date(newsletter.generated_at, newsletter.timezone) }}</div>
                    </td>
                    <td class="issue-cell" width="98" style="width:98px;text-align:right;vertical-align:middle;">
                      <div>{{ issue_code(newsletter.generated_at, newsletter.timezone) }}</div>
                      <span>WEEKLY EDITION</span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td class="intro-section section" bgcolor="#fcfbf8" style="padding:27px 32px 30px;background-color:#fcfbf8;">
                <div class="kicker" style="color:#8a5516;font-family:Arial,Helvetica,sans-serif;font-size:10px;font-weight:bold;line-height:14px;text-transform:uppercase;">The essential brief</div>
                <h1>Three things that matter</h1>
                <p class="deck" style="color:#4d5861;">A shorter read focused on the signals most likely to move markets or change portfolio risk.</p>
                <table role="presentation" class="signal-list" width="100%" cellpadding="0" cellspacing="0" border="0">
                  {% for signal in view.signals %}
                  <tr>
                    <td class="signal-index" width="42" style="width:42px;padding:19px 12px 19px 0;vertical-align:top;">0{{ loop.index }}</td>
                    <td class="signal-copy" style="padding:17px 0;border-top:1px solid #d9ddd9;vertical-align:top;">
                      <div class="signal-inner">
                      <div class="signal-meta" style="color:#15355b;font-family:Arial,Helvetica,sans-serif;font-size:9px;font-weight:bold;line-height:13px;text-transform:uppercase;">{{ signal.label }} <span>&middot;</span> MARKET IMPACT / {{ signal.risk }}</div>
                      <h2>{{ signal.headline }}</h2>
                      <p style="color:#35414c;">{{ signal.detail }}</p>
                      {% if signal.source %}<div class="source-line">SOURCE / <a href="{{ signal.source.url }}">{{ signal.source.name }}</a></div>{% endif %}
                      </div>
                    </td>
                  </tr>
                  {% endfor %}
                </table>
              </td>
            </tr>

            <tr>
              <td class="feature-section" bgcolor="#111820" style="padding:30px 32px 32px;background-color:#111820;color:#f2f3f2;border-top:3px solid #c4892f;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td class="feature-label">Story of the Week / Macro Pulse</td>
                    <td class="feature-source-count">{{ unique_source_count(newsletter.sections) }} VERIFIED SOURCES</td>
                  </tr>
                </table>
                <h2>{{ view.story.title }}</h2>
                <div class="topic-tags">{% for tag in story_tags(newsletter.sections.get("story_of_the_week", {})) %}<span>{{ tag }}</span>{% endfor %}</div>
                <div class="feature-block">
                  <div class="feature-subhead">The view</div>
                  <p>{{ view.story.view }}</p>
                </div>
                <div class="feature-block compact-feature">
                  <div class="feature-subhead">Why it matters</div>
                  <p>{{ view.story.why }}</p>
                </div>
                <div class="feature-block compact-feature">
                  <div class="feature-subhead">Watch next</div>
                  <p>{{ view.story.watch }}</p>
                </div>
                {% if view.story.sources %}
                <div class="feature-sources">SOURCES / {% for source in view.story.sources %}<a href="{{ source.url }}">{{ source.name }}</a>{% if not loop.last %} &middot; {% endif %}{% endfor %}</div>
                {% endif %}
              </td>
            </tr>

            {% set chart = newsletter.sections.get("chart_of_the_week") %}
            {% if chart %}
            <tr>
              <td class="section chart-section" bgcolor="#ffffff" style="padding:28px 32px 30px;background-color:#ffffff;">
                <div class="kicker" style="color:#8a5516;font-family:Arial,Helvetica,sans-serif;font-size:10px;font-weight:bold;line-height:14px;text-transform:uppercase;">Chart desk / {{ chart.source_name or "FRED" }}</div>
                <h2 class="section-title">Chart of the Week</h2>
                <h3 class="insight-title">{{ view.chart.title }}</h3>
                {% if chart.embedded_image %}<img class="chart-image" src="{{ chart.image_src or chart.preview_image_src or 'chart_of_the_week.png' }}" alt="{{ chart.title }}">{% endif %}
                {% if view.chart.summary %}<p class="body-copy">{{ view.chart.summary }}</p>{% endif %}
                {% if view.chart.key_read %}<div class="key-read"><strong>Why it matters</strong><span>{{ view.chart.key_read }}</span></div>{% endif %}
                <div class="source-line">DATA AS OF / {{ display_header_date(newsletter.generated_at, newsletter.timezone) }}{% if chart.original_url %} &nbsp;&middot;&nbsp; <a href="{{ chart.original_url }}">SOURCE</a>{% endif %}</div>
              </td>
            </tr>
            {% endif %}

            <tr>
              <td id="weekly-delta" class="section delta-section" bgcolor="#ffffff" style="padding:28px 32px 30px;background-color:#ffffff;">
                <div class="kicker" style="color:#8a5516;font-family:Arial,Helvetica,sans-serif;font-size:10px;font-weight:bold;line-height:14px;text-transform:uppercase;">Weekly delta / {{ view.weekly_delta.rows|length }} verified signals / {{ view.weekly_delta.source_count }} sources</div>
                <h2 class="section-title">What Changed This Week</h2>
                <p class="section-deck" style="color:#4d5861;">The observable shifts that changed the cross-asset backdrop.</p>
                {% if view.weekly_delta.rows %}
                <table class="delta-table" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;table-layout:fixed;">
                  <tr>
                    <th width="8%" style="width:8%;padding:8px 8px 8px 0;text-align:left;color:#59636c;">&nbsp;</th>
                    <th width="52%" style="width:52%;padding:8px 12px 8px 0;text-align:left;color:#59636c;">Signal</th>
                    <th width="20%" style="width:20%;padding:8px 12px;text-align:right;color:#59636c;">Latest</th>
                    <th width="20%" style="width:20%;padding:8px 0 8px 12px;text-align:right;color:#59636c;">1W</th>
                  </tr>
                  {% for row in view.weekly_delta.rows %}
                  <tr>
                    <td class="delta-index" style="padding:13px 8px 13px 0;border-bottom:1px solid #e2e4e1;color:#a46b1c;font-family:'Courier New',Courier,monospace;font-size:10px;line-height:15px;vertical-align:top;">{{ row.index_display }}</td>
                    <td class="delta-copy" style="padding:12px 12px 13px 0;border-bottom:1px solid #e2e4e1;color:#202a34;vertical-align:top;">
                      <strong class="delta-signal" style="display:block;color:#17202b;font-family:Georgia,'Times New Roman',serif;font-size:15px;line-height:20px;">{{ row.signal }}</strong>
                      <span class="delta-state state-{{ row.tone }}" style="display:block;margin-top:2px;color:{% if row.tone == 'positive' %}#167451{% elif row.tone == 'negative' %}#a23b36{% else %}#68727a{% endif %};font-family:Arial,Helvetica,sans-serif;font-size:8px;font-weight:bold;line-height:12px;text-transform:uppercase;">{{ row.state }}</span>
                      <span class="delta-interpretation" style="display:block;margin-top:5px;color:#5f6971;font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:15px;">{{ row.interpretation }}</span>
                      {% if row.source.name %}<span class="delta-source" style="display:block;margin-top:4px;color:#7b848b;font-family:Arial,Helvetica,sans-serif;font-size:8px;line-height:11px;text-transform:uppercase;">Source / {{ row.source.name }}</span>{% endif %}
                    </td>
                    <td class="delta-metric" style="padding:12px;border-bottom:1px solid #e2e4e1;border-left:1px solid #e7e9e6;text-align:right;white-space:nowrap;color:#25303a;font-family:'Courier New',Courier,monospace;font-size:12px;line-height:17px;vertical-align:top;">{{ row.current_display }}</td>
                    <td class="delta-metric state-{{ row.tone }}" style="padding:12px 0 12px 12px;border-bottom:1px solid #e2e4e1;border-left:1px solid #e7e9e6;text-align:right;white-space:nowrap;color:{% if row.tone == 'positive' %}#167451{% elif row.tone == 'negative' %}#a23b36{% else %}#59636c{% endif %};font-family:'Courier New',Courier,monospace;font-size:12px;font-weight:bold;line-height:17px;vertical-align:top;">{{ row.weekly_change_display }}</td>
                  </tr>
                  {% endfor %}
                </table>
                {% else %}
                <div class="data-note">{{ view.weekly_delta.empty_message }}</div>
                {% endif %}

                <div class="subsection-rule"></div>
                <div class="kicker" style="color:#8a5516;font-family:Arial,Helvetica,sans-serif;font-size:10px;font-weight:bold;line-height:14px;text-transform:uppercase;">Cross-asset exceptions</div>
                <h3 class="subsection-title">Dislocation Watch</h3>
                <p class="section-deck" style="color:#4d5861;">Relationships that moved against their usual directional pattern.</p>
                {% if view.dislocations["items"] %}
                {% for item in view.dislocations["items"] %}
                <table role="presentation" class="dislocation-row" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;table-layout:fixed;">
                  <tr>
                    <td width="74%" style="width:74%;padding:12px 14px;border-bottom:1px solid #e2e4e1;border-left:3px solid #c4892f;vertical-align:top;">
                      <span class="dislocation-label" style="display:block;color:#8a5516;font-family:Arial,Helvetica,sans-serif;font-size:8px;font-weight:bold;line-height:11px;text-transform:uppercase;">{{ item.label }}</span>
                      <strong class="dislocation-title" style="display:block;margin-top:3px;color:#17202b;font-family:Georgia,'Times New Roman',serif;font-size:14px;line-height:19px;">{{ item.title }}</strong>
                      <span class="dislocation-copy" style="display:block;margin-top:5px;color:#4f5a63;font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:15px;">{{ item.observation }} {{ item.why_it_matters }}</span>
                    </td>
                    <td width="26%" style="width:26%;padding:12px;border-bottom:1px solid #e2e4e1;vertical-align:top;">
                      <span class="mini-label" style="display:block;color:#68727a;font-family:Arial,Helvetica,sans-serif;font-size:8px;font-weight:bold;line-height:11px;text-transform:uppercase;">Affected</span>
                      <span class="dislocation-assets" style="display:block;margin-top:4px;color:#25303a;font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:15px;">{{ item.affected_assets }}</span>
                    </td>
                  </tr>
                </table>
                {% endfor %}
                {% else %}
                <div class="data-note">{{ view.dislocations.empty_message }}</div>
                {% endif %}
                <div class="source-line">METHOD / VERIFIED WEEKLY DELTAS &amp; THRESHOLD-BASED DIVERGENCES<br>{{ view.weekly_delta.note }}</div>
              </td>
            </tr>

            <tr>
              <td class="section markets-section" bgcolor="#fcfbf8" style="padding:28px 32px 30px;background-color:#fcfbf8;">
                <div class="kicker" style="color:#8a5516;font-family:Arial,Helvetica,sans-serif;font-size:10px;font-weight:bold;line-height:14px;text-transform:uppercase;">Cross-asset monitor</div>
                <h2 class="section-title">Markets at a glance</h2>
                <p class="section-deck" style="color:#4d5861;">The essential price moves, with secondary instruments left to the web edition.</p>

                {% if view.fx_rows %}
                <div class="table-label" style="color:#15355b;font-family:Arial,Helvetica,sans-serif;font-size:9px;font-weight:bold;line-height:13px;text-transform:uppercase;">FX</div>
                <table class="compact-table" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;table-layout:fixed;">
                  <tr>
                    <th width="34%" style="width:34%;padding:9px 14px;text-align:left;color:#59636c;">Asset</th>
                    <th width="22%" style="width:22%;padding:9px 14px;text-align:right;color:#59636c;">Last</th>
                    <th width="22%" style="width:22%;padding:9px 14px;text-align:right;color:#59636c;">1W</th>
                    <th width="22%" style="width:22%;padding:9px 14px;text-align:right;color:#59636c;">YTD</th>
                  </tr>
                  {% for row in view.fx_rows %}
                  <tr>
                    <td class="asset-cell" style="padding:10px 14px;border-bottom:1px solid #e2e4e1;color:#202a34;">{{ row.label }}</td>
                    <td class="number" style="padding:10px 14px;border-bottom:1px solid #e2e4e1;border-left:1px solid #e7e9e6;text-align:right;white-space:nowrap;color:#25303a;">{{ row.last }}</td>
                    <td class="number {{ change_class(row.one_week_change) }}" style="padding:10px 14px;border-bottom:1px solid #e2e4e1;border-left:1px solid #e7e9e6;text-align:right;white-space:nowrap;color:{% if row.one_week_change > 0 %}#167451{% elif row.one_week_change < 0 %}#a23b36{% else %}#59636c{% endif %};">{{ format_pct(row.one_week_change) }}</td>
                    <td class="number {{ change_class(row.ytd_change or 0) }}" style="padding:10px 14px;border-bottom:1px solid #e2e4e1;border-left:1px solid #e7e9e6;text-align:right;white-space:nowrap;color:{% if (row.ytd_change or 0) > 0 %}#167451{% elif (row.ytd_change or 0) < 0 %}#a23b36{% else %}#59636c{% endif %};">{{ format_pct(row.ytd_change or 0) }}</td>
                  </tr>
                  {% endfor %}
                </table>
                {% endif %}

                {% if view.commodity_rows %}
                <div class="table-label second-label" style="color:#15355b;font-family:Arial,Helvetica,sans-serif;font-size:9px;font-weight:bold;line-height:13px;text-transform:uppercase;">Commodities</div>
                <table class="compact-table" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;table-layout:fixed;">
                  <tr>
                    <th width="34%" style="width:34%;padding:9px 14px;text-align:left;color:#59636c;">Asset</th>
                    <th width="22%" style="width:22%;padding:9px 14px;text-align:right;color:#59636c;">Last</th>
                    <th width="22%" style="width:22%;padding:9px 14px;text-align:right;color:#59636c;">1W</th>
                    <th width="22%" style="width:22%;padding:9px 14px;text-align:right;color:#59636c;">YTD</th>
                  </tr>
                  {% for row in view.commodity_rows %}
                  <tr>
                    <td class="asset-cell" style="padding:10px 14px;border-bottom:1px solid #e2e4e1;color:#202a34;">{{ row.label }}</td>
                    <td class="number" style="padding:10px 14px;border-bottom:1px solid #e2e4e1;border-left:1px solid #e7e9e6;text-align:right;white-space:nowrap;color:#25303a;">{{ row.last }}</td>
                    <td class="number {{ change_class(row.one_week_change) }}" style="padding:10px 14px;border-bottom:1px solid #e2e4e1;border-left:1px solid #e7e9e6;text-align:right;white-space:nowrap;color:{% if row.one_week_change > 0 %}#167451{% elif row.one_week_change < 0 %}#a23b36{% else %}#59636c{% endif %};">{{ format_pct(row.one_week_change) }}</td>
                    <td class="number {{ change_class(row.ytd_change or 0) }}" style="padding:10px 14px;border-bottom:1px solid #e2e4e1;border-left:1px solid #e7e9e6;text-align:right;white-space:nowrap;color:{% if (row.ytd_change or 0) > 0 %}#167451{% elif (row.ytd_change or 0) < 0 %}#a23b36{% else %}#59636c{% endif %};">{{ format_pct(row.ytd_change or 0) }}</td>
                  </tr>
                  {% endfor %}
                </table>
                {% endif %}

                {% if view.sector_rows %}
                <div class="subsection-rule"></div>
                <h3 class="subsection-title">Sector leadership</h3>
                {% for row in view.sector_rows %}
                <div class="sector-region-label" style="margin:0 0 7px;color:#15355b;font-family:Arial,Helvetica,sans-serif;font-size:9px;line-height:13px;font-weight:bold;text-transform:uppercase;">{{ row.label }}</div>
                <table role="presentation" class="sector-metrics" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;table-layout:fixed;">
                  <tr>
                    <td width="34%" style="width:34%;padding:13px 15px;border:1px solid #dde0dc;vertical-align:top;">
                      <span style="display:block;margin-bottom:5px;color:#5f6971;font-family:Arial,Helvetica,sans-serif;font-size:9px;line-height:13px;font-weight:bold;text-transform:uppercase;">Leader</span>
                      <strong style="display:block;color:#25303a;font-size:12px;line-height:17px;">{{ row.leader }}</strong>
                      <em class="positive" style="display:block;margin-top:4px;color:#167451;font-family:'Courier New',Courier,monospace;font-size:10px;line-height:13px;font-style:normal;">{{ format_pct(row.leader_change) }}</em>
                    </td>
                    <td width="34%" style="width:34%;padding:13px 15px;border:1px solid #dde0dc;vertical-align:top;">
                      <span style="display:block;margin-bottom:5px;color:#5f6971;font-family:Arial,Helvetica,sans-serif;font-size:9px;line-height:13px;font-weight:bold;text-transform:uppercase;">Laggard</span>
                      <strong style="display:block;color:#25303a;font-size:12px;line-height:17px;">{{ row.laggard }}</strong>
                      <em class="negative" style="display:block;margin-top:4px;color:#a23b36;font-family:'Courier New',Courier,monospace;font-size:10px;line-height:13px;font-style:normal;">{{ format_pct(row.laggard_change) }}</em>
                    </td>
                    <td width="32%" style="width:32%;padding:13px 15px;border:1px solid #dde0dc;vertical-align:top;">
                      <span style="display:block;margin-bottom:5px;color:#5f6971;font-family:Arial,Helvetica,sans-serif;font-size:9px;line-height:13px;font-weight:bold;text-transform:uppercase;">Breadth</span>
                      <strong style="display:block;color:#25303a;font-size:12px;line-height:17px;">{{ row.breadth }}</strong>
                    </td>
                  </tr>
                </table>
                {% if row.note %}<div class="data-note" style="padding:9px 2px;color:#58636c;font-size:10px;line-height:15px;font-style:italic;">{{ row.note }}</div>{% endif %}
                {% endfor %}
                {% endif %}
              </td>
            </tr>

            {% if view.portfolio_metrics %}
            <tr>
              <td class="section portfolio-section" bgcolor="#ffffff" style="padding:28px 32px 30px;background-color:#ffffff;">
                <div class="kicker" style="color:#8a5516;font-family:Arial,Helvetica,sans-serif;font-size:10px;font-weight:bold;line-height:14px;text-transform:uppercase;">Portfolio lens</div>
                <h2 class="section-title">Portfolio impact</h2>
                {% if view.portfolio_interpretation %}<p class="section-deck portfolio-deck">{{ view.portfolio_interpretation }}</p>{% endif %}
                <table role="presentation" class="metric-grid" width="100%" cellpadding="0" cellspacing="0" border="0">
                  {% for metric_row in view.portfolio_metrics|batch(2, none) %}
                  <tr>
                    {% for metric in metric_row %}
                    {% if metric %}
                    <td class="metric-card" width="50%" style="width:50%;padding:14px 15px;border:1px solid #dde0dc;vertical-align:top;">
                      <div class="metric-label">{{ metric.label }}</div>
                      <strong>{{ metric.value }}</strong>
                      <span class="{{ metric.tone }}" style="color:{% if metric.tone == 'positive' %}#167451{% elif metric.tone == 'negative' %}#a23b36{% else %}#59636c{% endif %};">{{ metric.detail }}</span>
                    </td>
                    {% endif %}
                    {% endfor %}
                  </tr>
                  {% endfor %}
                </table>
              </td>
            </tr>
            {% endif %}

            {% if view.watch_rows %}
            <tr>
              <td class="section outlook-section" bgcolor="#fcfbf8" style="padding:28px 32px 30px;background-color:#fcfbf8;">
                <div class="kicker" style="color:#8a5516;font-family:Arial,Helvetica,sans-serif;font-size:10px;font-weight:bold;line-height:14px;text-transform:uppercase;">Forward calendar</div>
                <h2 class="section-title">Week ahead</h2>
                <table role="presentation" class="watch-list" width="100%" cellpadding="0" cellspacing="0" border="0">
                  {% for row in view.watch_rows %}
                  <tr>
                    <td class="watch-region" width="76" style="width:76px;padding:14px 12px 14px 0;border-top:1px solid #dfe2de;vertical-align:top;">{{ row.region }}</td>
                    <td class="watch-copy" style="padding:13px 0;border-top:1px solid #dfe2de;vertical-align:top;">
                      <h3>{{ row.event }}</h3>
                      <p>{{ row.portfolio_relevance }}</p>
                      <div class="source-line">AFFECTED / {{ row.asset_classes }}</div>
                    </td>
                  </tr>
                  {% endfor %}
                </table>
              </td>
            </tr>
            {% endif %}

            {% if view.headlines %}
            <tr>
              <td class="section scan-section" bgcolor="#ffffff" style="padding:28px 32px 30px;background-color:#ffffff;">
                <div class="kicker" style="color:#8a5516;font-family:Arial,Helvetica,sans-serif;font-size:10px;font-weight:bold;line-height:14px;text-transform:uppercase;">Global scan</div>
                <h2 class="section-title">One headline per region</h2>
                <table role="presentation" class="headline-list" width="100%" cellpadding="0" cellspacing="0" border="0">
                  {% for item in view.headlines %}
                  <tr>
                    <td class="headline-region" width="76" style="width:76px;padding:13px 12px 13px 0;border-top:1px solid #dfe2de;vertical-align:top;">{{ item.region }}</td>
                    <td class="headline-copy" style="padding:12px 0;border-top:1px solid #dfe2de;vertical-align:top;">
                      {% if item.url %}<a href="{{ item.url }}">{{ item.headline }}</a>{% else %}<span>{{ item.headline }}</span>{% endif %}
                      <div class="headline-meta">{{ item.source }} &middot; {{ item.category }}</div>
                    </td>
                  </tr>
                  {% endfor %}
                </table>
              </td>
            </tr>
            {% endif %}

            <tr>
              <td class="footer" bgcolor="#111820" style="padding:24px 32px 27px;background-color:#111820;color:#aeb5bc;">
                <div class="footer-brand">Wolf Research</div>
                <div class="footer-title">{{ newsletter.title }}</div>
                <p><strong>Generated:</strong> {{ newsletter.generated_at }} &nbsp;&middot;&nbsp; {{ newsletter.timezone }}</p>
                <p>Internal distribution only. Analytical context, not investment advice. Sources link to original publications where available.</p>
                <p>Detailed holdings, full sector tables, secondary headlines, fallback usage, and validation records remain available in the web edition and audit log.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
